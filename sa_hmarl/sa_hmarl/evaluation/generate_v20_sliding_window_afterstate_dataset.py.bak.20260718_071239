def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--seeds", type=str, default="5001,5002")
    parser.add_argument("--mode", choices=["A", "B"], default="B",
                        help="A = fixed-C / all-OD pure RMSA; B = DF_C closed loop.")
    parser.add_argument("--future_policy", choices=list(FUTURE_POLICIES),
                        default="df_c_ppo_r_top1")
    parser.add_argument("--agent_r_checkpoint",
                        default="sa_hmarl/checkpoints/agent_r_mixed.pt")
    parser.add_argument("--topology", default="xlron_cost239_ptrnet_real")
    parser.add_argument("--num_slots", type=int, default=320)
    parser.add_argument("--num_servers", type=int, default=4)
    parser.add_argument("--k_paths_r", type=int, default=50)
    parser.add_argument("--k_paths_c", type=int, default=5)
    parser.add_argument("--path_sort_strategy_r", default="hops")
    parser.add_argument("--block_sort_strategy_r", default="start_asc")
    parser.add_argument("--path_sort_strategy_c", default="hops")
    parser.add_argument("--block_sort_strategy_c", default="start_asc")
    parser.add_argument("--modulation_profile", default="default")
    parser.add_argument("--max_blocks", type=int, default=10)
    parser.add_argument("--split_profile", default="default3")
    parser.add_argument("--num_splits", type=int, default=3)
    parser.add_argument("--arrival_interval", type=float, default=0.3)
    parser.add_argument("--holding_min", type=float, default=20.0)
    parser.add_argument("--holding_max", type=float, default=30.0)
    parser.add_argument("--deadline_min", type=float, default=30.0)
    parser.add_argument("--deadline_max", type=float, default=100.0)
    parser.add_argument("--size_min_mb", type=float, default=5.0)
    parser.add_argument("--size_max_mb", type=float, default=30.0)
    parser.add_argument("--edge_cost_min", type=float, default=0.1)
    parser.add_argument("--edge_cost_max", type=float, default=2.2)
    parser.add_argument("--warmup_requests", type=int, default=500)
    parser.add_argument("--requests_per_episode", type=int, default=6000)
    parser.add_argument("--topk", type=int, default=30)
    parser.add_argument("--horizons", type=str, default="5,20,50")
    parser.add_argument("--fixed_split_id", type=int, default=0)
    parser.add_argument("--poisson_arrivals", action="store_true")
    parser.add_argument("--exponential_holding", action="store_true")
    parser.add_argument("--output_dir",
                        default="sa_hmarl/experiments/"
                                "v20_sliding_window_afterstate_dataset_phase1/dataset_shards")
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--max_groups_per_seed", type=int, default=None,
                        help="Optional cap on emitted groups per seed (smoke tests).")
    parser.add_argument("--log_interval", type=int, default=100)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    os.environ.setdefault("OMP_NUM_THREADS", "1")
    os.environ.setdefault("MKL_NUM_THREADS", "1")
    os.environ.setdefault("OPENBLAS_NUM_THREADS", "1")
    os.environ.setdefault("NUMEXPR_NUM_THREADS", "1")
    os.environ.setdefault("TORCH_NUM_THREADS", "1")

    seeds = [int(s.strip()) for s in args.seeds.split(",") if s.strip()]
    if not seeds:
        raise ValueError("--seeds must contain at least one integer")
    args.horizons = sorted(set(
        int(h.strip()) for h in str(args.horizons).split(",") if h.strip()
    ))
    if not args.horizons or any(h <= 0 for h in args.horizons):
        raise ValueError(f"--horizons must be positive integers, got {args.horizons}")
    if args.topk < 1 or args.topk > 30:
        raise ValueError(f"--topk must be in [1, 30] (PPO-R legal Top-30 pool); got {args.topk}")
    if args.mode == "A" and args.future_policy not in FUTURE_POLICIES:
        raise ValueError(f"Unknown future_policy: {args.future_policy}")

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    env_proto = make_env(
        args.topology,
        args.num_slots,
        args.num_servers,
        42,
        modulation_profile=args.modulation_profile,
        max_blocks=args.max_blocks,
        block_sort_strategy=args.block_sort_strategy_r,
        path_sort_strategy=args.path_sort_strategy_r,
        k=args.k_paths_r,
    )
    server_node_ids = [int(s.node_id) for s in env_proto.mec.servers]

    print(f"Loading frozen PPO-R: {args.agent_r_checkpoint}")
    agent_r = _load_ppo_r(args.agent_r_checkpoint, env_proto.mod_reg, args.device)
    r_state_ref = {k: v.clone() for k, v in agent_r.policy_net.state_dict().items()}

    t_start = time.time()
    per_seed = []
    for seed in seeds:
        per_seed.append(_run_seed(seed, args, agent_r, server_node_ids, output_dir))

    frozen_unchanged = all(
        torch.equal(agent_r.policy_net.state_dict()[k], r_state_ref[k])
        for k in r_state_ref
    )

    metadata = {
        "schema": SCHEMA_NAME,
        "schema_version": SCHEMA_VERSION,
        "config": {k: v for k, v in vars(args).items() if not k.startswith("_")},
        "seeds": seeds,
        "server_node_ids": server_node_ids,
        "fixed_split_id": args.fixed_split_id,
        "no_ppo_c_loaded": True,
        "no_ppo_c_action_selected": True,
        "traffic_matrix": "uniform_all_od",
        "candidate_pool": "ppo_r_legal_topk_only",
        "ksp_ff_role": "coverage_diagnostic_only",
        "ksp_ff_implementation": "ksp_ff_highest_mod_action",
        "feature_names": AFTERSTATE_FEATURE_NAMES,
        "feature_dim": len(AFTERSTATE_FEATURE_NAMES),
        "feature_notes": {
            "total_dim": 32,
            "section_C_note": (
                "Spec listed 11 names for section C but fixed the total at 32 "
                "dims; global_util_std is omitted from features. Server "
                "utilization dispersion remains available as the per-window "
                "label server_util_std."
            ),
            "legal_r_ratio": (
                "Legal R-mask ratio of the first future step (next request, "
                "after time advancement, under the future policy C choice); "
                "0.0 when no future request remains."
            ),
            "phi_spec": "log1p(free_ratio*100) + 0.3*log1p(lfb*100)",
            "normalization": {
                "deadline_norm": "deadline_ms / deadline_max",
                "holding_norm": "holding_time / holding_max",
                "intermediate_size_norm": "intermediate_size_mb / size_max_mb",
            },
        },
        "horizons": args.horizons,
        "risk_coefs": RISK_COEFS,
        "label_notes": {
            "containers": [f"labels_H{h}" for h in args.horizons],
            "keys_unsuffixed": True,
            "resource_usage_means": "over successful future requests only (0.0 if none)",
            "ranking": "competition (min) ranking, ascending, 1 = best, ties share best rank",
            "single_rollout": (
                "One future rollout per candidate at max(horizons); labels for "
                "all horizons are extracted from the same trace."
            ),
        },
        "group_id_rule": "seed * 1000000 + request_index",
        "agent_r_checkpoint": args.agent_r_checkpoint,
        "agent_r_sha256": _sha256_file(args.agent_r_checkpoint),
        "agent_r_frozen_unchanged": frozen_unchanged,
        "per_seed": per_seed,
        "generation_seconds": time.time() - t_start,
    }
    meta_path = output_dir / "metadata.json"
    meta_path.write_text(json.dumps(metadata, indent=2, default=str), encoding="utf-8")
    print(f"[dataset] Wrote metadata to {meta_path}")
    print(f"[dataset] Done in {metadata['generation_seconds']:.1f}s")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
